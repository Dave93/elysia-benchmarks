<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One-shot LaunchAgent for scripts/overnight-hono.sh.
  ProcessType=Interactive is the whole point: cron schedules its children as
  background work and they ran ~3x slow (see results/friction-log.md, 2026-09-24).
  Replace /ABSOLUTE/PATH/TO below with your checkout, then install:  cp scripts/dev.davr.hono-overnight.plist ~/Library/LaunchAgents/
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.davr.hono-overnight.plist
  The script unloads and deletes the agent itself when it exits.
  Edit Month/Day before installing; with neither set it would fire every night.
-->
<plist version="1.0"><dict>
  <key>Label</key><string>dev.davr.hono-overnight</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/ABSOLUTE/PATH/TO/elysia_benchmarks/scripts/overnight-hono.sh</string></array>
  <key>ProcessType</key><string>Interactive</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Month</key><integer>9</integer>
    <key>Day</key><integer>28</integer>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardErrorPath</key><string>/tmp/hono-overnight.launchd.err</string>
</dict></plist>
